{
  "manifest_version": 3,
  "key": "",
  "name": "Edit.or.lynx Download",
  "short_name": "Edit.or.lynx",
  "version": "1.0.0",
  "description": "Sends the links, videos and files you start in the browser to Edit.or.lynx on your Mac.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:47820/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Edit.or.lynx Download",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Download this page with Edit.or.lynx"
    }
  }
}
